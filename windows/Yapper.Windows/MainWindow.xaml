<Window x:Class="Yapper.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Yapper for Windows · Preview" Icon="Yapper.ico" Width="1120" Height="780" MinWidth="900" MinHeight="640" Closing="OnClosing">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Yapper" FontSize="30" FontWeight="Bold"/>
      <TextBlock Text="Your voice, on your computer. Windows preview · local processing." Margin="0,4,0,14" Foreground="#63526C"/>
      <Border Background="#F5EDF7" CornerRadius="10" Padding="12" Margin="0,0,0,14">
        <StackPanel><TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap" AutomationProperties.AutomationId="status"/><ProgressBar x:Name="Progress" Height="5" Margin="0,8,0,0" Minimum="0" Maximum="1"/><WrapPanel><Button x:Name="CancelButton" Content="Cancel current job" Click="CancelJob" IsEnabled="False"/><Button x:Name="RetryButton" Content="Retry retained audio" Click="RetryTranscription" IsEnabled="False"/></WrapPanel></StackPanel>
      </Border>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Shivam · Audio stays local. Speaker labels can be wrong; review important words." Foreground="#706078" Margin="0,12,0,0"/>
    <TabControl x:Name="Tabs" Background="White" BorderBrush="#D9CBDC">
      <TabItem Header="Transcribe">
        <DockPanel Margin="18">
          <StackPanel DockPanel.Dock="Top">
            <WrapPanel><TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ModelChoice" Width="270" SelectionChanged="SelectModel"/><TextBlock Text="Language" VerticalAlignment="Center"/><ComboBox x:Name="LanguageChoice" Width="160"><ComboBoxItem Content="Auto-detect" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Hindi" Tag="hi"/><ComboBoxItem Content="Gujarati" Tag="gu"/><ComboBoxItem Content="Chinese" Tag="zh"/></ComboBox></WrapPanel>
            <WrapPanel><CheckBox x:Name="DetectSpeakers" Content="Detect speakers" IsChecked="True"/><CheckBox x:Name="SingleSpeaker" Content="One speaker (faster)"/></WrapPanel>
            <TextBlock Text="Record only with everyone's consent. Microphone audio only, not system sound." Foreground="#63526C" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,10,0,10"><Button Content="Import audio" Click="ImportAudio"/><Button x:Name="RecordButton" Content="Record microphone" Click="RecordConversation"/><Button Content="Copy transcript" Click="CopyTranscript"/><Button Content="Play / pause" Click="PlayAudio"/><Button Content="Review / edit turns" Click="ReviewTurns"/></WrapPanel>
          </StackPanel>
          <TextBox x:Name="TranscriptText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16" AutomationProperties.AutomationId="transcript"/>
        </DockPanel>
      </TabItem>
      <TabItem Header="History">
        <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,15,0"><Button DockPanel.Dock="Bottom" Content="Delete selected history entry" Click="DeleteRecording"/><ListBox x:Name="HistoryList" DisplayMemberPath="Label" SelectionChanged="SelectRecording"/></DockPanel>
          <DockPanel Grid.Column="1"><WrapPanel DockPanel.Dock="Top"><Button Content="Copy" Click="CopyTranscript"/><Button Content="Play / pause" Click="PlayAudio"/><Button Content="Review / edit turns" Click="ReviewTurns"/></WrapPanel><TextBox x:Name="HistoryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="AI Models"><DockPanel Margin="18"><TextBlock DockPanel.Dock="Top" Text="Speed and accuracy are relative estimates, not benchmarks. CPU inference may be slow on large models." TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel DockPanel.Dock="Bottom"><Button Content="Download selected + speaker models" Click="DownloadModels"/><Button Content="Delete selected model" Click="DeleteModel"/></WrapPanel><ListBox x:Name="ModelsList" SelectionChanged="ChooseCatalogModel"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Description}"/><TextBlock Text="Speed"/><ProgressBar Value="{Binding Speed}" Maximum="10" Height="5" Width="350" HorizontalAlignment="Left"/><TextBlock Text="Accuracy"/><ProgressBar Value="{Binding Accuracy}" Maximum="10" Height="5" Width="350" HorizontalAlignment="Left"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
      <TabItem Header="Dictionary"><DockPanel Margin="18"><TextBlock DockPanel.Dock="Top" Text="Literal replacements for dictation only. Conversation transcripts stay unchanged."/><WrapPanel DockPanel.Dock="Top"><TextBox x:Name="TriggerText" Width="200" ToolTip="Spoken phrase"/><TextBox x:Name="ReplacementText" Width="310" ToolTip="Replacement"/><Button Content="Add rule" Click="AddRule"/><Button Content="Remove selected" Click="RemoveRule"/></WrapPanel><DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Spoken phrase" Binding="{Binding Trigger}" Width="*"/><DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
      <TabItem Header="Settings"><ScrollViewer><StackPanel Margin="18" MaxWidth="650" HorizontalAlignment="Left">
        <TextBlock Text="Dictation shortcut" FontWeight="Bold"/><ComboBox x:Name="HotkeyChoice"><ComboBoxItem Content="Control+Alt+Space"/><ComboBoxItem Content="Control+Alt+F9"/><ComboBoxItem Content="Control+Shift+F10"/></ComboBox>
        <TextBlock Text="Fn is handled by keyboard firmware on many Windows PCs; use a configurable shortcut instead." TextWrapping="Wrap" Foreground="#63526C"/>
        <CheckBox x:Name="ToggleMode" Content="Toggle recording (otherwise hold shortcut)"/><CheckBox x:Name="RestoreClipboard" Content="Restore clipboard after auto-paste"/><CheckBox x:Name="TrimPeriod" Content="Trim a lone final period on short dictation"/><CheckBox x:Name="AutoEdit" Content="Remove common English filler words from dictation"/>
        <TextBlock Text="Microphone" FontWeight="Bold"/><ComboBox x:Name="MicrophoneChoice"/>
        <WrapPanel><Button Content="Save settings" Click="SaveSettings"/><Button Content="Microphone privacy settings" Click="OpenPrivacy"/><Button Content="Open local data folder" Click="OpenData"/></WrapPanel>
        <TextBlock Text="Closing the window keeps Yapper in the tray. Use Quit in the tray menu to exit. Downloads are explicit; transcription does not send audio to a server." TextWrapping="Wrap" Margin="0,15,0,0"/>
        <TextBlock x:Name="StatisticsText" TextWrapping="Wrap" Margin="0,18,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
