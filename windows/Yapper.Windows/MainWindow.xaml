<Window x:Class="Yapper.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Yapper for Windows" Icon="Yapper.ico" Width="1200" Height="820" MinWidth="900" MinHeight="640" Closing="OnClosing">
  <Window.Resources>
    <DataTemplate x:Key="RecordingCard">
      <StackPanel>
        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" MaxHeight="65" TextTrimming="CharacterEllipsis" FontSize="14" Margin="0,0,0,10"/>
        <WrapPanel><TextBlock Text="{Binding Date, StringFormat={}{0:g}}" Style="{StaticResource Caption}" Margin="0,0,14,0"/><TextBlock Text="{Binding Model}" Style="{StaticResource Caption}"/></WrapPanel>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource ContentBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,0,1,0"/>
    <TabControl x:Name="Tabs" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SidebarTab}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,30,0,0">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,12,18,28"><Image Source="Yapper.ico" Width="40" Height="40" Margin="0,0,10,0"/><TextBlock Text="Yapper" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center"/></StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="22,16,22,20"><Border Height="1" Background="{DynamicResource SubtleBorder}" Margin="0,0,0,14"/><TextBlock Text="Shivam" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryInk}"/><TextBlock Text="Windows 1.1.1" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </DockPanel>
            <ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="Dashboard" Tag="&#xE80F;" AutomationProperties.AutomationId="sidebar.dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
          <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/><TextBlock Text="A little less typing. A little more you." Style="{StaticResource Subtitle}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,10,18"><StackPanel><TextBlock x:Name="Greeting" Text="Welcome back," Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DashboardWords" Text="0" Style="{StaticResource MetricValue}"/><TextBlock Text="words transcribed" Foreground="{DynamicResource SecondaryInk}"/><TextBlock x:Name="DashboardSaved" Style="{StaticResource Caption}" Margin="0,20,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,18"><StackPanel><TextBlock Text="This week" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DashboardWeek" Text="0" Style="{StaticResource MetricValue}"/><TextBlock Text="transcriptions" Foreground="{DynamicResource SecondaryInk}"/><TextBlock x:Name="DashboardToday" Style="{StaticResource Caption}" Margin="0,20,0,0"/></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="View all" Click="ViewHistory" HorizontalAlignment="Right"/><TextBlock Text="Recent transcriptions" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="RecentEmpty" Text="Your words will appear here after your first recording." Style="{StaticResource Subtitle}"/><ListBox x:Name="RecentList" ItemTemplate="{StaticResource RecordingCard}" SelectionChanged="SelectRecent" AutomationProperties.AutomationId="recentRecordings"/><WrapPanel><Button Content="Copy" Click="CopyTranscript"/><Button Content="Play / pause" Click="PlayAudio"/><Button Content="Review / edit turns" Click="ReviewTurns"/></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Transcribe Audio" Tag="&#xE720;" AutomationProperties.AutomationId="sidebar.transcribeAudio">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
          <TextBlock Text="Transcribe Audio" Style="{StaticResource PageTitle}"/><TextBlock Text="Conversations, in your own words." Style="{StaticResource Subtitle}"/>
          <Border Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Local conversation transcription" Style="{StaticResource SectionTitle}"/><TextBlock Text="On your computer · no dictionary replacements" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
            <TextBlock Text="Transcription model" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="ModelChoice" SelectionChanged="SelectModel" AutomationProperties.Name="Transcription model"/>
            <TextBlock Text="Language" Foreground="{DynamicResource SecondaryInk}" Margin="0,8,0,0"/><ComboBox x:Name="LanguageChoice" SelectionChanged="ChangePreferences" AutomationProperties.Name="Spoken language"><ComboBoxItem Content="Hinglish · Latin script" Tag="hinglish"/><ComboBoxItem Content="Auto-detect" Tag="auto"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Hindi" Tag="hi"/><ComboBoxItem Content="Gujarati" Tag="gu"/><ComboBoxItem Content="Chinese" Tag="zh"/></ComboBox>
            <WrapPanel><CheckBox x:Name="DetectSpeakers" Content="Detect speakers · up to 8" IsChecked="True"/><CheckBox x:Name="SingleSpeaker" Content="One speaker (faster)"/></WrapPanel>
            <CheckBox x:Name="IncludeTimestamps" Content="Include timestamps in transcript" Checked="ChangePreferences" Unchecked="ChangePreferences" AutomationProperties.AutomationId="includeTimestamps"/>
            <TextBlock Text="You can switch between paragraph and timestamped views after processing. Timing data is always retained." Style="{StaticResource Caption}"/>
            <TextBlock Text="Mixed languages and overlapping speech can produce errors. Review and edit the words and speaker labels after processing." Style="{StaticResource Caption}" Margin="0,4,0,14"/>
            <WrapPanel><Button Content="Import audio" Click="ImportAudio" Style="{StaticResource PrimaryAction}"/><Button x:Name="RecordButton" Content="Record microphone" Click="RecordConversation"/></WrapPanel>
            <TextBlock Text="Record only with everyone's consent. Microphone audio only, not system sound." Style="{StaticResource Caption}" Margin="0,14,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Transcript" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,0,0,10"><Button Content="Copy transcript" Click="CopyTranscript"/><Button Content="Play / pause" Click="PlayAudio"/><Button Content="Review / edit turns" Click="ReviewTurns"/></WrapPanel><TextBlock x:Name="ProcessingDetails" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="TranscriptText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180" MaxHeight="500" FontSize="15" AutomationProperties.AutomationId="transcript"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="History" Tag="&#xE81C;" AutomationProperties.AutomationId="sidebar.history">
        <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="History" Style="{StaticResource PageTitle}"/><TextBlock Text="Your recordings and the words worth keeping." Style="{StaticResource Subtitle}"/></StackPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,18,0"><Button DockPanel.Dock="Bottom" Content="Delete selected entry" Click="DeleteRecording"/><ListBox x:Name="HistoryList" ItemTemplate="{StaticResource RecordingCard}" SelectionChanged="SelectRecording" AutomationProperties.AutomationId="historyRecordings"/></DockPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="Copy" Click="CopyTranscript"/><Button Content="Play / pause" Click="PlayAudio"/><Button Content="Review / edit turns" Click="ReviewTurns"/></WrapPanel><TextBlock x:Name="HistoryProcessingDetails" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBox x:Name="HistoryText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Dictionary" Tag="&#xE82D;" AutomationProperties.AutomationId="sidebar.dictionary">
        <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Dictionary" Style="{StaticResource PageTitle}"/><TextBlock Text="Your words, your way. Replacements apply only to dictation." Style="{StaticResource Subtitle}"/></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Add a replacement" Style="{StaticResource SectionTitle}"/><TextBlock Text="Spoken phrase" Foreground="{DynamicResource SecondaryInk}"/><TextBox x:Name="TriggerText" AutomationProperties.Name="Spoken phrase"/><TextBlock Text="Replace with" Foreground="{DynamicResource SecondaryInk}"/><TextBox x:Name="ReplacementText" AutomationProperties.Name="Replacement"/><WrapPanel><Button Content="Add rule" Click="AddRule" Style="{StaticResource PrimaryAction}"/><Button Content="Remove selected" Click="RemoveRule"/></WrapPanel></StackPanel></Border>
          <DataGrid Grid.Row="2" x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Spoken phrase" Binding="{Binding Trigger}" Width="*"/><DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="2*"/></DataGrid.Columns></DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="Statistics" Tag="&#xE9D9;" AutomationProperties.AutomationId="sidebar.statistics">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Statistics" Style="{StaticResource PageTitle}"/><TextBlock Text="A look at the time you've spent speaking instead of typing." Style="{StaticResource Subtitle}"/>
          <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,10,18"><StackPanel><TextBlock Text="Words transcribed" Foreground="{DynamicResource SecondaryInk}"/><TextBlock x:Name="StatsWords" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,18"><StackPanel><TextBlock Text="Transcriptions" Foreground="{DynamicResource SecondaryInk}"/><TextBlock x:Name="StatsCount" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,18"><StackPanel><TextBlock Text="Recorded minutes" Foreground="{DynamicResource SecondaryInk}"/><TextBlock x:Name="StatsMinutes" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,18"><StackPanel><TextBlock Text="Estimated typing minutes saved" Foreground="{DynamicResource SecondaryInk}"/><TextBlock x:Name="StatsSaved" Style="{StaticResource MetricValue}"/><TextBlock Text="Based on 40 words per minute." Style="{StaticResource Caption}"/></StackPanel></Border></UniformGrid>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local storage" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="StatisticsText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInk}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="AI Models" Tag="&#xE950;" AutomationProperties.AutomationId="sidebar.aiModels">
        <DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="AI Models" Style="{StaticResource PageTitle}"/><TextBlock Text="One selected model for dictation and conversations. Everything runs locally." Style="{StaticResource Subtitle}"/><TextBlock Text="Speed and accuracy bars are relative estimates, not benchmarks. Larger models take more time and memory on CPU." Style="{StaticResource Caption}" Margin="0,0,0,16"/></StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="Download selected + speaker models" Click="DownloadModels" Style="{StaticResource PrimaryAction}"/><Button Content="Delete selected model" Click="DeleteModel"/></WrapPanel>
          <ListBox x:Name="ModelsList" SelectionChanged="ChooseCatalogModel"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInk}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Speed" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ProgressBar Value="{Binding Speed}" Maximum="10" Height="5" Foreground="{DynamicResource BlueAccent}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Accuracy" Style="{StaticResource Caption}" Margin="0,0,0,6"/><ProgressBar Value="{Binding Accuracy}" Maximum="10" Height="5"/></StackPanel></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Settings" Tag="&#xE713;" AutomationProperties.AutomationId="sidebar.settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Make Yapper feel at home." Style="{StaticResource Subtitle}"/>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose a theme, or follow Windows." Style="{StaticResource Caption}" Margin="0,0,0,8"/><ComboBox x:Name="ThemeChoice" SelectionChanged="ChangeTheme" AutomationProperties.AutomationId="themeChoice" AutomationProperties.Name="Appearance"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Primary hotkey" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="HotkeyChoice" SelectionChanged="ChangeHotkey" AutomationProperties.Name="Dictation shortcut"><ComboBoxItem Content="Control+Alt+Space"/><ComboBoxItem Content="Control+Alt+F9"/><ComboBoxItem Content="Control+Shift+F10"/></ComboBox><CheckBox x:Name="ToggleMode" Content="Toggle recording (otherwise hold shortcut)" Checked="ChangePreferences" Unchecked="ChangePreferences"/><TextBlock Text="Fn is handled by keyboard firmware on many PCs. Use your selected Windows shortcut to start and stop dictation." Style="{StaticResource Caption}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="General" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="RestoreClipboard" Content="Restore clipboard after auto-paste" Checked="ChangePreferences" Unchecked="ChangePreferences"/><TextBlock Text="Closing the window keeps Yapper in the tray. Use Quit in the tray menu to exit." Style="{StaticResource Caption}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Transcript cleanup" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="TrimPeriod" Content="Trim a lone final period on short dictation" Checked="ChangePreferences" Unchecked="ChangePreferences"/><CheckBox x:Name="AutoEdit" Content="Remove safe fillers, capitalize sentences, and format explicit paragraph, bullet, numbered-list, and scratch-that commands" Checked="ChangePreferences" Unchecked="ChangePreferences"/><TextBlock Text="Cleanup runs locally. Conversation transcripts are never changed by dictation cleanup or dictionary rules." Style="{StaticResource Caption}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Audio and permissions" Style="{StaticResource SectionTitle}"/><TextBlock Text="Microphone" Foreground="{DynamicResource SecondaryInk}"/><ComboBox x:Name="MicrophoneChoice" AutomationProperties.Name="Microphone"/><WrapPanel><Button Content="Microphone privacy settings" Click="OpenPrivacy"/><Button Content="Open local data folder" Click="OpenData"/></WrapPanel><TextBlock Text="Downloads are explicit. Transcription does not send audio to a server." Style="{StaticResource Caption}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AutoCheckUpdates" Content="Automatically check GitHub for updates" Checked="ChangePreferences" Unchecked="ChangePreferences"/><TextBlock Text="Yapper asks before downloading or installing. Windows installers are currently unsigned, so Windows may ask you to confirm the publisher." Style="{StaticResource Caption}" Margin="0,0,0,12"/><WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates" AutomationProperties.AutomationId="checkUpdates"/><Button x:Name="InstallUpdateButton" Content="Download and install" Click="InstallUpdate" IsEnabled="False"/></WrapPanel><TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInk}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" Grid.Column="1" Margin="28,0,28,16" Padding="14,10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
      <StackPanel><TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryInk}" AutomationProperties.AutomationId="status"/><ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1"/><WrapPanel><Button x:Name="CancelButton" Content="Cancel current job" Click="CancelJob" IsEnabled="False"/><Button x:Name="RetryButton" Content="Retry retained audio" Click="RetryTranscription" IsEnabled="False"/></WrapPanel></StackPanel>
    </Border>
  </Grid>
</Window>
